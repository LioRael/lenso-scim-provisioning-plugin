{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Keep Lenso authority-boundary and database upgrades reviewed",
      "matchPackageNames": ["sqlx", "/^lenso(?:-|$)/"],
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ]
}
